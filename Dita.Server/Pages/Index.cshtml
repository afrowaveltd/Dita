@page
@using Microsoft.Extensions.Localization;
@model IndexModel
@{
    ViewData["Title"] = Model._localizer["Home page"];
}

<section class="dita-page-header">
    <p class="dita-eyebrow">Dita Server</p>
    <h1>@Model._localizer["Welcome"]</h1>
    <p>@Model._localizer["DITA is your"]&nbsp;<b>@Model._localizer["Disks testing application."]</b></p>
</section>

<div class="dita-metric-grid">

    <article class="dita-metric-card">
        <span>@Model._localizer["Localization"]</span>
        <strong>50+</strong>
        <small>@Model._localizer["supported languages"]</small>
    </article>

    <article class="dita-metric-card">
        <span>@Model._localizer["Translation"]</span>
        <strong>@Model._localizer["Realtime"]</strong>
        <small>@Model._localizer["SignalR"]</small>
    </article>

    <article class="dita-metric-card danger">
        <span>@Model._localizer["API"]</span>
        <strong>@Model._localizer["REST"]</strong>
        <small>@Model._localizer["OpenAPI / Scalar docs"]</small>
    </article>

    <article class="dita-metric-card">
        <span>@Model._localizer["Translation service"]</span>
        <strong>@Model._localizer["Live monitor"]</strong>
        <small><a asp-area="" asp-page="/Admin/LiveTranslation">@Model._localizer["Open monitor"] &rarr;</a></small>
    </article>

</div>
