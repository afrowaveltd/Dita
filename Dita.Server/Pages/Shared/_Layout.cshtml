@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IndexModel> t;
<!DOCTYPE html>
<html lang="en" data-dita-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dita</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dita.theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dita.layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="dita-nav">
        <a class="dita-nav-brand" asp-area="" asp-page="/Index">
            <img src="~/resources/Dita1.png" alt="Dita" asp-append-version="true" />
        </a>

        <button class="dita-nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" id="navToggle">
            ☰
        </button>

        <ul class="dita-nav-links" id="navLinks">
            <li><a asp-area="" asp-page="/Index">@t["Home"]</a></li>
            <li><a asp-area="" asp-page="/Privacy">@t["Privacy"]</a></li>
            <li><a href="/scalar/Dita" target="_blank" rel="noopener">@t["API Explorer"]</a></li>
            <li><a asp-area="" asp-page="/Admin/LiveTranslation">@t["Dashboard"]</a></li>
        </ul>

        <div class="dita-nav-actions">
            <button class="dita-theme-toggle" type="button" title="@t["Switch theme"]" aria-label="Switch theme" id="globalThemeToggle">
                <span id="themeToggleIcon">☀</span>
            </button>
        </div>
    </nav>

    <div class="dita-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="dita-footer">
        <span>&copy; 2026 Dita</span>
        <span><a asp-area="" asp-page="/Privacy">@t["Privacy"]</a></span>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dita.theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>